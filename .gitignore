### Not published ###
# The Python Canvas/Ed sync. Nothing in the Java app references it — it is a separate client that
# posts to the API — and its config.py holds live Canvas, Ed and app tokens. Kept locally, out of
# the repository.
src/main/todo-sync/

### Secrets — never commit these ###
# Local overrides of application.yml (Spring picks these up automatically)
src/main/resources/application-local.yml
src/main/resources/application-local.properties
.env

### Local H2 database files (the "h2" profile) ###
data/
*.mv.db
*.trace.db

### Build output ###
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### Maven ###
.mvn/wrapper/maven-wrapper.jar
# A project-local Maven repository: hundreds of megabytes of downloaded jars, all of them
# re-downloadable from pom.xml. This lives under src/main/, so without this line it would be
# committed along with the source.
src/main/.m2-cache/

### Python ###
__pycache__/
*.py[cod]
.venv/
venv/
env/

### A stray "git init" left in the working tree; a nested .git confuses the outer repo ###
jira_repo/

